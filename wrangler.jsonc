{
  // Cloudflare Workers: public/ 정적 자산을 그대로 올리고(없는 주소는 404.html),
  // /api/push/* · /api/contact(문의 양식) 만 Worker(worker/index.js)가 받는다 — 관심 구역 웹 푸시(구독 저장은 KV, 매일 07:30 KST 발송)
  "name": "eolmamyeon",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/push/*", "/api/contact", "/api/contact/*"]
  },
  "kv_namespaces": [{ "binding": "PUSH", "id": "97677fe6952f47158d738a96a480f443" }],
  // 사이클 5 fix A: 아침 창 07:30~08:30(서울)에 10분마다 — 한 실행 PUSH_BATCH통씩 이어 보내 구독이 많아도 같은 아침에 끝난다(worker/SETUP.md · 하루 최대 1통은 state.day가 지킨다)
  "triggers": { "crons": ["30,40,50 22 * * *", "0,10,20,30 23 * * *"] },
  "observability": { "enabled": true }
}
