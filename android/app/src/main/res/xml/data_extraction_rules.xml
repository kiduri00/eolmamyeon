<?xml version="1.0" encoding="utf-8"?>
<!-- 앱 자체에는 저장하는 데이터가 없다(찜·조건은 Chrome 저장소). 백업·기기 이전 대상에서 모두 뺀다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
